<!DOCTYPE html>
<html lang="fr">
<%- include('partials/head', { scripts: ['/js/catways.js'], noCache: true }) %>
<body>
  <%- include('partials/menu') %>

  <main class="content">
    <h1>Gestion des catways</h1>

    <section class="form-box">
      <h2>Ajouter un catway</h2>
      <form id="createCatwayForm">
        <label>Numéro</label>
        <input type="number" name="catwayNumber" required />
        <label>Type</label>
        <select name="catwayType" required>
          <option value="long">long</option>
          <option value="short">short</option>
        </select>
        <label>État</label>
        <input type="text" name="catwayState" required />
        <button type="submit">Créer</button>
        <p id="createError" class="error"></p>
      </form>
    </section>

    <h2>Liste des catways</h2>
    <table>
      <thead>
        <tr><th>Numéro</th><th>Type</th><th>État</th><th>Actions</th></tr>
      </thead>
      <tbody id="catwaysBody">
        <% catways.forEach(c => { %>
          <tr data-id="<%= c.catwayNumber %>">
            <td><%= c.catwayNumber %></td>
            <td><%= c.catwayType %></td>
            <td><input type="text" class="stateInput" value="<%= c.catwayState %>" /></td>
            <td>
              <button class="saveBtn">Enregistrer</button>
              <button class="deleteBtn">Supprimer</button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </main>
</body>
</html>
